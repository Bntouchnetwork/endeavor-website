{
  "manifest_version": 3,
  "name": "LinkedIn Manager · Endeavor",
  "short_name": "LinkedIn Manager",
  "version": "1.0.0",
  "description": "Lê só o que está na sua tela do LinkedIn, destaca oportunidades e sugere a resposta com a IA da Endeavor. Manual por padrão.",
  "default_locale": "en",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "LinkedIn Manager", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "permissions": ["storage"],
  "host_permissions": ["https://www.linkedin.com/*", "https://onaewjlozioderwlvgfm.supabase.co/*"],
  "content_scripts": [{ "matches": ["https://www.linkedin.com/*"], "js": ["core.js", "content.js"], "css": ["panel.css"], "run_at": "document_idle" }]
}
