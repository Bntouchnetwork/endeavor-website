{
  "manifest_version": 3,
  "name": "My WhatsApp Manager · Endeavor",
  "short_name": "WhatsApp Manager",
  "version": "1.0.0",
  "description": "Painel da Endeavor ao lado do WhatsApp Web, com o Hub AI: sugestões, resumo, CRM, agenda, proposta, tradução e IA Takeover.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Abrir ou fechar o My WhatsApp Manager", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "notifications"],
  "host_permissions": ["https://web.whatsapp.com/*", "https://onaewjlozioderwlvgfm.supabase.co/*"],
  "content_scripts": [{
    "matches": ["https://web.whatsapp.com/*"],
    "js": ["core.js", "wa-dom.js", "panel.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{ "resources": ["panel.css", "icons/icon48.png"], "matches": ["https://web.whatsapp.com/*"] }]
}
